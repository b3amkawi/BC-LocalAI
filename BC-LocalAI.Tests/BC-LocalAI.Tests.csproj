<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BC-LocalAI\BC-LocalAI.csproj" />
    <!-- SEC-003 admin account script (internals visible to this project). -->
    <ProjectReference Include="..\tools\BcAdmin\BcAdmin.csproj" />
    <None Include="..\database\chat-history\*.sql" Link="ChatHistorySchema\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Offline fixture tool only: no authentication implementation is added to the app. -->
    <Compile Include="..\tools\Sec001Fixtures\FixtureFactory.cs" Link="Sec001\FixtureFactory.cs" />
  </ItemGroup>

</Project>
